{
  "name": "ytl",
  "displayName": "YTL",
  "description": "YTL (Yggdrasil Template Language) is a new minimalist text format designed for configurations, logs, and declarative data structures. Its defining feature is a tree-like architecture and unique inverted inheritance that completely eliminates code duplication and visual clutter.",
  "version": "1.2.0",
  "publisher": "Regent",
  "repository": {
    "type": "git",
    "url": "https://github.com/Regentq/YTL"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:ytl"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ytl",
        "aliases": [
          "YTL",
          "ytl"
        ],
        "extensions": [
          ".ytl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ytl",
        "scopeName": "source.ytl",
        "path": "./syntaxes/ytl.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[ytl]": {
        "editor.formatOnType": true
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "comment.line.double-slash.ytl",
            "settings": {
              "foreground": "#5C6370",
              "fontStyle": "italic"
            }
          },
          {
            "scope": "entity.name.class.ytl",
            "settings": {
              "foreground": "#E5C07B",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "entity.name.tag.level1.ytl",
            "settings": {
              "foreground": "#E5C07B"
            }
          },
          {
            "scope": "entity.name.tag.level2.ytl",
            "settings": {
              "foreground": "#5dd47b"
            }
          },
          {
            "scope": "entity.name.tag.level3.ytl",
            "settings": {
              "foreground": "#6bc5da"
            }
          },
          {
            "scope": "variable.other.property.ytl",
            "settings": {
              "foreground": "#61AFEF"
            }
          },
          {
            "scope": "keyword.control.ytl",
            "settings": {
              "foreground": "#C678DD"
            }
          },
          {
            "scope": "constant.language.enum.ytl",
            "settings": {
              "foreground": "#81a2ff",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "constant.numeric.ytl",
            "settings": {
              "foreground": "#f5b641"
            }
          },
          {
            "scope": "constant.numeric.hex.ytl",
            "settings": {
              "foreground": "#4996ee"
            }
          },
          {
            "scope": "constant.other.date.ytl",
            "settings": {
              "foreground": "#56B6C2"
            }
          },
          {
            "scope": "constant.other.time.ytl",
            "settings": {
              "foreground": "#28a1f1"
            }
          },
          {
            "scope": "string.quoted.double.ytl",
            "settings": {
              "foreground": "#98C379"
            }
          },
          {
            "scope": "constant.character.escape.ytl",
            "settings": {
              "foreground": "#D19A66",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "constant.other.network.ip.ipv4.ytl",
            "settings": {
              "foreground": "#acdf5b"
            }
          },
          {
            "scope": "constant.other.network.socket.ipv4.ytl",
            "settings": {
              "foreground": "#8bb34c"
            }
          },
          {
            "scope": "constant.other.network.ip.ipv6.ytl",
            "settings": {
              "foreground": "#57abc5"
            }
          },
          {
            "scope": "constant.other.network.socket.ipv6.ytl",
            "settings": {
              "foreground": "#4991a7"
            }
          },
          {
            "scope": "constant.other.network.url.ytl",
            "settings": {
              "foreground": "#00ffbf",
              "fontStyle": "underline"
            }
          },
          {
            "scope": "constant.language.boolean.ytl",
            "settings": {
              "foreground": "#ff4b81"
            }
          },
          {
            "scope": "constant.language.null.ytl",
            "settings": {
              "foreground": "#ff9100"
            }
          },
          {
            "scope": "constant.numeric.special.ytl",
            "settings": {
              "foreground": "#00e1ff"
            }
          },
          {
            "scope": "constant.numeric.mac.classic.ytl",
            "settings": {
              "foreground": "#4cff9d"
            }
          },
          {
            "scope": "constant.numeric.mac.alternative.ytl",
            "settings": {
              "foreground": "#4cff9d"
            }
          },
          {
            "scope": "constant.numeric.mac.short.ytl",
            "settings": {
              "foreground": "#4cff9d"
            }
          }
        ]
      }
    }
  }
}
