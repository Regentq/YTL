{
  "name": "ytl",
  "displayName": "YTL",
  "description": "YTL (Yggdrasil Template Language) is a new minimalist text format designed for configurations, logs, and declarative data structures. Its defining feature is a tree-like architecture and unique inverted inheritance that completely eliminates code duplication and visual clutter.",
  "version": "1.0.0",
  "publisher": "Regent",
  "repository": {
    "type": "git",
    "url": "https://github.com/Regentq/YTL"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {

    "languages": [{
      "id": "ytl",
      "aliases": ["YTL", "ytl"],
      "extensions": [".ytl"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "ytl",
      "scopeName": "source.ytl",
      "path": "./syntaxes/ytl.tmLanguage.json"
    }],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
                "scope": "comment.line.double-slash.ytl",
                "settings": { "foreground": "#5C6370", "fontStyle": "italic" }
          },
          {
                "scope": "entity.name.class.ytl",
                "settings": { "foreground": "#E5C07B", "fontStyle": "bold" }
          },
          {
                "scope": "keyword.control.ytl",
                "settings": { "foreground": "#C678DD" }
          },
          {
                "scope": "variable.other.property.ytl",
                "settings": { "foreground": "#61AFEF" }
          },
          {
                "scope": "constant.numeric.ytl",
                "settings": { "foreground": "#f5b641" }
          },
          {
                "scope": "constant.numeric.hex.ytl",
                "settings": { "foreground": "#4996ee" }
          },
          {
                "scope": "constant.other.date.ytl",
                "settings": { "foreground": "#56B6C2" }
          },
          {
                "scope": "constant.other.time.ytl",
                "settings": { "foreground": "#28a1f1" }
          },
          {
                "scope": "string.quoted.double.ytl",
                "settings": { "foreground": "#98C379" }
          },
          {
                "scope": "constant.character.escape.ytl",
                "settings": { "foreground": "#D19A66", "fontStyle": "bold" }
          }
        ]
      }
    }
  }
}
